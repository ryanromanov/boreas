! Subroutines return results through `out` / `inout` parameters.
! A parameter with no mode is `in` and cannot be assigned inside the callee.
! Writes that reach the caller are marked `update`, so they stand out.

subroutine swap(inout integer :: a, inout integer :: b)
  integer :: t
  t = a
  update a = b
  update b = t
end subroutine

subroutine swap_real(inout real :: a, inout real :: b)
  real :: t
  t = a
  update a = b
  update b = t
end subroutine

subroutine circle(in real :: r, out real :: area, out real :: circumference)
  update area = 3.14159 * r ** 2
  update circumference = 2.0 * 3.14159 * r
end subroutine

subroutine scale(in real :: k, inout real :: xs)
  update xs = xs * k
end subroutine

program demo
  integer :: x = 1
  integer :: y = 2
  real :: a
  real :: c
  real :: v(3) = [1.0, 2.0, 3.0]

  call swap(x, y)
  print "after swap:", x, y

  call circle(3.0, a, c)
  print "circle r=3:", a, c

  call scale(10.0, v)
  print "scaled:", v

  call swap_real(v(1), v(3))          ! array elements work too
  print "swapped ends:", v
end program
