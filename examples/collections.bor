! Maps and sets. Keys and members are integers or strings.

! A map can be a parameter: read-only unless it is `inout`.
function total(map[string, integer] :: m) -> integer
  allocatable string[] :: ks
  integer :: i
  integer :: t = 0
  ks = keys(m)
  do i = 1, size(ks)
    t = t + m[ks[i]]
  end do
  return t
end function

! `inout` changes the caller's map; writes that reach the caller carry `@`, and call add/remove need no mark.
subroutine bump(inout map[string, integer] :: m, string :: word)
  @m[word] = (get(m, word) ?? 0) + 1
end subroutine

! A set (or a map) can be a function result.
function distinct(string[] :: words) -> set[string]
  set[string] :: s
  integer :: i
  do i = 1, size(words)
    call add(s, words[i])
  end do
  return s
end function

! A record can hold them; a field starts empty.
record inventory
  string :: owner = "shop"
  map[string, integer] :: stock
  set[string] :: tags
end record

program demo
  map[string, integer] :: age
  set[string] :: seen
  allocatable string[] :: words
  allocatable string[] :: names
  integer :: i

  ! A map: insert or replace with an assignment, read with brackets.
  age["ann"] = 31
  age["bob"] = 40
  age["ann"] = 32
  println(age)                          ! {ann: 32, bob: 40}
  println(age["ann"], size(age))        ! 32 2

  ! A missing key is an error. Ask first, or use get, which gives null when it is not there.
  println(has(age, "cy"))               ! false
  println(get(age, "cy") ?? -1)         ! -1

  ! Counting words: the usual use of a map.
  words = split("the cat saw the dog and the cat", " ")
  map[string, integer] :: count
  do i = 1, size(words)
    count[words[i]] = (get(count, words[i]) ?? 0) + 1
  end do
  println(count)                        ! {the: 3, cat: 2, saw: 1, dog: 1, and: 1}

  ! keys() and values() are arrays in the same order, so an ordinary loop walks a map.
  names = keys(count)
  do i = 1, size(names)
    if count[names[i]] > 1 then
      println(names[i], "appears", count[names[i]], "times")
    end if
  end do

  ! A set remembers members. add and remove are subroutines, so they are called.
  do i = 1, size(words)
    call add(seen, words[i])
  end do
  println(size(seen), "different words")    ! 5 different words
  call remove(seen, "the")
  println(has(seen, "the"), seen)           ! false {cat, saw, dog, and}

  ! Assigning copies: the two stay separate.
  map[string, integer] :: copy = count
  copy["extra"] = 1
  println(has(count, "extra"), has(copy, "extra"))    ! false true

  ! Parameters, results and record fields.
  map[string, integer] :: tally
  call bump(tally, "x")
  call bump(tally, "x")
  call bump(tally, "y")
  println(tally, total(tally))               ! {x: 2, y: 1} 3
  println(distinct(words))                   ! {the, cat, saw, dog, and}

  inventory :: shop
  shop.stock["pen"] = 3
  call bump(shop.stock, "pen")
  call add(shop.tags, "office")
  println(shop)                              ! inventory(owner=shop, stock={pen: 4}, tags={office})
end program
