! Boreas: a Fortran-flavored language. Keywords are case-insensitive.

function square(real :: x) -> real
  return x * x
end function

function fib(integer :: n) -> integer
  if n < 2 then
    return n
  end if
  return fib(n - 1) + fib(n - 2)
end function

program demo
  integer :: i
  integer :: count = 0
  real :: total = 0.0
  real[5] :: xs
  integer[5] :: ys = [1, 2, 3, 4, 5]

  do i = 1, 5
    xs[i] = square(real(i))
    total = total + xs[i]
  end do
  println("squares:", xs)
  println("total =", total)

  ys = ys * 2 + 1                 ! whole-array arithmetic
  println("ys =", ys, " middle =", ys[2:4])

  do i = 1, 20
    if mod(i, 3) == 0 then
      cycle
    else if i > 10 then
      exit
    else
      count = count + 1
    end if
  end do
  println("kept", count)

  println("fib(15) =", fib(15))
end program demo
