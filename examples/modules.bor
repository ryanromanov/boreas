! A module groups constants and procedures. Everything in it is private
! unless marked `public`, and a program imports exactly the names it uses.

module geometry
  public const real :: pi = 3.14159
  const real :: unit_square = 1.0          ! private: only this module can see it

  public function area(real :: r) -> real
    return pi * r ** 2
  end function

  public function ratio(real :: r) -> real
    return area(r) / scale_factor(unit_square)
  end function

  function scale_factor(real :: x) -> real   ! private helper
    return x * 1.0
  end function
end module

module counting
  use geometry: pi

  public function tally(integer :: n) -> (integer :: evens, real :: tau)
    integer :: i
    integer :: count = 0
    do i = 1, n
      if mod(i, 2) == 0 then
        count = count + 1
      end if
    end do
    return count, 2.0 * pi
  end function
end module

program demo
  use geometry: area, pi
  use counting: tally
  integer :: e
  real :: t

  println("area of r=2:", area(2.0))
  println("pi:", pi)
  (e, t) = tally(10)
  println("evens:", e, " tau:", t)
end program
