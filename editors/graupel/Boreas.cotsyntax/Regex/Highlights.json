{
  "keywords": [
    {
      "begin": "(?<=\\bif\\b[^\\n]{1,300}[ \\t)\\]])is(?=[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]+(?:as|then)\\b)",
      "ignoreCase": true,
      "regularExpression": true,
      "description": "is in if x is T"
    },
    {
      "begin": "(?<=\\bis[ \\t]{1,40}[A-Za-z_][A-Za-z0-9_]{0,62}[ \\t]{1,40})as\\b",
      "ignoreCase": true,
      "regularExpression": true,
      "description": "as in if x is T as c"
    },
    {
      "begin": "(?<=\\brecord[ \\t]{1,40}[A-Za-z_][A-Za-z0-9_]{0,62}[ \\t]{1,40})is\\b",
      "ignoreCase": true,
      "regularExpression": true,
      "description": "is in record r is iface"
    },
    {
      "begin": "(?<=\\bselect[ \\t]{1,40}type\\b[^\\n]{1,300}[ \\t])as\\b",
      "ignoreCase": true,
      "regularExpression": true,
      "description": "as in select type x as p"
    },
    {
      "begin": "@|->|::|\\?\\?|\\+%|-%|\\*%",
      "ignoreCase": true,
      "regularExpression": true
    },
    {
      "begin": "\\b(program|module|function|subroutine|record|interface|const|use|call|return|exit|cycle|print|println|if|then|else|do|while|end|select|case|default|fallthrough|break|allocate|deallocate|allocatable|public|private|and|or|not|write|writeln|stop|close)\\b",
      "ignoreCase": true,
      "regularExpression": true
    }
  ],
  "types": [
    {
      "begin": "\\b(integer|real|complex|logical|string|int8|int16|int32|int64|real32|real64|file)\\b",
      "ignoreCase": true,
      "regularExpression": true
    },
    {
      "begin": "\\b(in|out|inout)\\b",
      "ignoreCase": true,
      "regularExpression": true
    }
  ],
  "commands": [
    {
      "begin": "\\b(size|shape|reshape|matmul|transpose|cshift|dot_product|allocated|present|sum|product|maxval|minval|any|all|count|pack|maxloc|minloc|merge|max|min|huge|epsilon|tiny|sqrt|abs|sin|cos|tan|asin|acos|atan|atan2|sinh|cosh|tanh|asinh|acosh|atanh|exp|log|log10|gamma|log_gamma|erf|erfc|hypot|real|int|floor|ceiling|nint|aint|anint|mod|modulo|sign|dim|cmplx|aimag|conjg|int8|int16|int32|int64|real32|real64|trim|len_trim|len|index|achar|iachar|fixed|scientific|general|tf|text|split|fields|field|to_integer|to_real|to_logical|right|left|repeat|random|argument|argument_count|read_line|open|try_open|exists|isnan|isinf|nan|infinity)(?=\\s*\\()",
      "ignoreCase": true,
      "regularExpression": true
    }
  ],
  "values": [
    {
      "begin": "\\b(true|false|null)\\b",
      "ignoreCase": true,
      "regularExpression": true
    }
  ],
  "numbers": [
    {
      "begin": "\\b\\d+\\.\\d*(e[-+]?\\d+)?|\\.\\d+(e[-+]?\\d+)?|\\b\\d+e[-+]?\\d+|\\b\\d+\\b",
      "ignoreCase": true,
      "regularExpression": true
    }
  ]
}
