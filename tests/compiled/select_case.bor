! select case: values, ranges, text, fallthrough, break, and select as an expression
function grade(int :: g) -> string
  select case g
    case 90:100
      return "A"
    case 80:89
      return "B"
    case 1, 3, 5
      return "odd"
    case :0
      return "neg"
    case default
      return "other"
  end select
  return "unreachable"
end function

program t
  int :: i
  do i = -1, 100, 11
    println(i, grade(i))
  end do
  string :: s = "pear"
  select case fallthrough s
    case "apple":"cherry"
      println("early")
    case "pear"
      println("pear")
    case default
      println("and default")
  end select
  do i = 1, 4
    select case i
      case 2
        cycle
      case 4
        exit
    end select
    println(select case i
      case 1 -> "one"
      case default -> text(i) + "!"
    end select)
  end do
end program
