! Maps and sets: counting words, the order entries were added in, copies, loops, parameters.
function longest(map[string, int] :: lengths) -> int
  int :: best = 0
  string :: word
  int :: n
  do word, n in lengths
    if n > best then
      best = n
    end if
  end do
  return best
end function

subroutine tally(inout map[string, int] :: count, string :: word)
  @count[word] = (get(count, word) ?? 0) + 1
end subroutine

record shelf
  string :: name = "fiction"
  map[string, int] :: stock
  set[string] :: tags
end record

function groups() -> map[string, set[string]]
  map[string, set[string]] :: g
  set[string] :: s
  call add(@s, "ann")
  g["a"] = s                                ! the map keeps its own copy
  call add(@s, "bob")
  g["b"] = s
  return g
end function

subroutine bump(inout int :: n)
  @n = n + 1
end subroutine

subroutine fresh(out int :: n)
  @n = 7
end subroutine

program maps
  map[string, int] :: count
  set[string] :: seen
  string :: word
  int :: n

  call tally(@count, "pear")
  call tally(@count, "fig")
  call tally(@count, "pear")
  call add(@seen, "pear")
  call add(@seen, "fig")
  call remove(@seen, "pear")
  call add(@seen, "pear")                 ! goes to the end
  println(count, seen, size(count), has(count, "fig"), get(count, "plum") ?? 0)

  map[string, int] :: copy = count         ! a copy: changing it leaves count alone
  copy["fig"] = 10
  println(count == copy, count == {"pear": 2, "fig": 1}, longest(copy))

  do word, n in count
    println(word, n)
  end do

  map[int, logical] :: flags = {1: true, 2: false}
  println(flags, keys(flags), values(flags))

  shelf :: a
  a.stock["dune"] = 3                       ! a record's maps start empty and work like variables
  call add(@a.tags, "scifi")
  shelf :: b = a                            ! copying the record copies its maps
  b.stock["dune"] = 9
  println(a, b.stock["dune"], has(a.tags, "scifi"))

  map[string, set[string]] :: team = groups()
  call add(@team["a"], "cy")                ! a set inside a map is changed in place
  map[string, int[]] :: rows
  rows["k"] = [1, 2, 3]
  rows["k"][2] = 20
  println(team, size(team["b"]), rows, sum(rows["k"]))
  call bump(@rows["k"][1])                   ! an entry (or an element of one) can be passed as inout or out
  call fresh(@a.stock["new"])
  println(rows, a.stock["new"])
end program maps
