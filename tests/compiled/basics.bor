! Whole numbers and reals, loops and functions: the part of the language the compiler handles first.
function square(int :: n) -> int
  return n * n
end function

function half(real :: x) -> real
  return x / 2
end function

function collatz(int :: n) -> int
  int :: steps = 0
  int :: k = n
  do while k /= 1
    if mod(k, 2) == 0 then
      k = k / 2
    else
      k = 3 * k + 1
    end if
    steps = steps + 1
  end do
  return steps
end function

subroutine show(int :: a, real :: b, logical :: c)
  println(a, b, c)
end subroutine

program basics
  int :: i
  int :: total = 0
  real :: x = 0.1
  do i = 1, 10
    total = total + square(i)
  end do
  println("total", total, "x", x + 0.2, half(5))
  println(collatz(27), 7 / 2, -7 / 2, mod(-7, 3), 2 ** 10, 2.0 ** 0.5)
  call show(1, 2, true)
  println(1.0e16, 1.0e-5, 100.0, 123456789.125, sqrt(2.0), exp(1.0), pi)
  do i = 10, 1, -3
    print(i)
    print(" ")
  end do
  println()
  println(i, max(1, 2.5), min(3, 4), abs(-5), abs(-2.5), int(2.9), real(3))
  println(1 < 2, 1.5 >= 2, true and false, not true, 3 /= 3)
  do i = 1, 3
    if i == 2 then
      cycle
    end if
    if i == 3 then
      exit
    end if
    println("i =", i)
  end do
  stop 0
end program
